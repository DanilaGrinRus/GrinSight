import { Theme, Help } from "theme.slint";

export component Card inherits Rectangle {
    in property <color> edge: Theme.line;
    background: Theme.card;
    border-radius: 18px;
    border-width: 1px;
    border-color: edge;
}

// A button. In the Ч/Б theme it turns black and yellow under the pointer or
// when it has keyboard focus.
export component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <length> font-size: 15px;
    callback clicked;
    min-height: 44px;
    min-width: label.preferred-width + 28px;
    border-radius: 12px;
    border-width: 1px;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    property <bool> hot: Theme.dots && (touch.has-hover || focus.has-focus);
    background: hot ? Theme.hot-bg : primary ? (touch.pressed ? Theme.accent.darker(0.15) : Theme.accent) : (touch.has-hover ? Theme.soft : transparent);
    border-color: hot ? Theme.hot-fg : primary ? Theme.accent : Theme.line;

    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.hot ? Theme.hot-fg : root.primary ? Theme.on-accent : Theme.text;
        font-size: root.font-size;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.clicked();
        }
    }
}

// One of several ways to do a thing: a mark and its words. Choosing it
// does nothing yet; the action is the button under the choices.
// One unspent output of the wallet (O51).
export struct OutLine {
    amount: string,
    // the block it is in, in digits
    block: string,
    // what holds it back, in words; empty when it can be spent
    state: string,
    // it can be chosen for a payment now
    free: bool,
    // marked "not to be spent" by the owner
    kept: bool,
    // chosen for the payment that is being prepared
    picked: bool,
}

export component Choice inherits Rectangle {
    in property <string> text;
    in property <bool> chosen: false;
    callback clicked;
    min-height: 44px;
    border-radius: 12px;
    border-width: root.chosen ? 2px : 1px;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    property <bool> hot: Theme.dots && (touch.has-hover || focus.has-focus);
    background: hot ? Theme.hot-bg : root.chosen ? Theme.soft : (touch.has-hover ? Theme.soft : transparent);
    border-color: hot ? Theme.hot-fg : root.chosen ? Theme.accent : Theme.line;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: 2px;
                border-color: root.chosen ? Theme.accent : Theme.muted;
                Rectangle { x: 5px; y: 5px; width: 8px; height: 8px; border-radius: 4px; background: root.chosen ? Theme.accent : transparent; }
            }
        }
        Text { text: root.text; color: root.hot ? Theme.hot-fg : Theme.text; font-size: 14px; font-weight: root.chosen ? 600 : 500; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.clicked();
        }
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <color> fg: Theme.warn;
    in property <color> fill: Theme.warn-soft;
    in property <length> text-size: 13px;
    background: fill;
    border-radius: 10px;
    height: 32px;
    width: chip-text.preferred-width + 24px;
    chip-text := Text {
        text: root.text;
        color: root.fg;
        font-size: root.text-size;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

export component Heading inherits Text {
    color: Theme.text;
    font-size: 15px;
    font-weight: 600;
}

// A "?" next to a thing: what is said about it in full is shown only to
// whoever asks (O41) - in a window of its own, at the size of ordinary
// text (O73), with `title` over it.
export component Ask inherits Rectangle {
    in property <string> title;
    in property <string> text;
    width: 30px;
    height: 30px;
    border-radius: 15px;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.line;
    background: touch.has-hover ? Theme.soft : transparent;
    accessible-role: button;
    accessible-label: @tr("What is this?");
    accessible-action-default => { root.show(); }
    function show() {
        Help.title = root.title;
        Help.text = root.text;
        Help.open = true;
    }
    Text { text: "?"; color: touch.has-hover ? Theme.accent : Theme.muted; font-size: 15px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.show(); } }
}

// A heading with its "?" and, for whoever asked, the words behind it.
export component Explained inherits VerticalLayout {
    in property <string> title;
    in property <string> words;
    in property <bool> small: false;
    spacing: 6px;
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Text { text: root.title; color: root.small ? Theme.muted : Theme.text; font-size: root.small ? 12px : 15px; font-weight: root.small ? 400 : 600; vertical-alignment: center; wrap: word-wrap; }
        Ask { title: root.title; text: root.words; }
    }
}

export component Muted inherits Text {
    color: Theme.muted;
    font-size: 13px;
    wrap: word-wrap;
}

export component Logo inherits Image {
    source: @image-url("../images/icon.png");
    image-fit: contain;
    accessible-role: image;
    accessible-label: "GrinSight";
}

// The dotted ground of the Ч/Б theme.
export component Ground inherits Rectangle {
    background: Theme.bg;
    if Theme.dots: Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../images/dot.png");
        horizontal-tiling: repeat;
        vertical-tiling: repeat;
    }
}

// O75: the signs of the actions on a contact, drawn as lines (24-unit box).
export global Icons {
    out property <string> send: "M 4 12 L 20 4 L 14 20 L 11.5 13.5 Z M 11.5 13.5 L 20 4";
    out property <string> edit: "M 4 20 L 8 20 L 19 9 L 15 5 L 4 16 Z M 13.5 6.5 L 17.5 10.5";
    out property <string> trash: "M 4 7 L 20 7 M 10 11 L 10 17 M 14 11 L 14 17 M 6 7 L 7 20 L 17 20 L 18 7 M 9 7 L 9 4 L 15 4 L 15 7";
    out property <string> ask: "M 12 4 L 12 16 M 6 10 L 12 16 L 18 10 M 5 20 L 19 20";
    out property <string> shield: "M 12 3 L 19 6 L 19 12 C 19 16.5 16 19.5 12 21 C 8 19.5 5 16.5 5 12 L 5 6 Z M 9 12 L 11 14 L 15 10";
    out property <string> window: "M 14 4 L 20 4 L 20 10 M 20 4 L 12 12 M 18 14 L 18 19 L 5 19 L 5 6 L 10 6";
    out property <string> more: "M 4.5 12 L 5.5 12 M 11.5 12 L 12.5 12 M 18.5 12 L 19.5 12";
    out property <string> plus: "M 12 5 L 12 19 M 5 12 L 19 12";
    out property <string> find: "M 16 16 L 20 20 M 18 11 C 18 14.9 14.9 18 11 18 C 7.1 18 4 14.9 4 11 C 4 7.1 7.1 4 11 4 C 14.9 4 18 7.1 18 11 Z";
    out property <string> tick: "M 5 12 L 10 17 L 19 7";
}

export component Icon inherits Path {
    in property <string> sign;
    in property <color> tint: Theme.text;
    in property <length> size: 16px;
    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.sign;
    stroke: root.tint;
    stroke-width: 2px;
    stroke-line-cap: round;
    fill: transparent;
}

// A small button with a sign only; what it does is said to a screen reader
// and, under the pointer, in words next to it (`says`).
export component IconBtn inherits Rectangle {
    in property <string> sign;
    in property <string> says;
    in property <bool> danger: false;
    in property <length> side: 32px;
    callback clicked;
    out property <bool> hover: touch.has-hover;
    width: root.side;
    height: root.side;
    border-radius: 8px;
    border-width: 1px;
    border-color: touch.has-hover ? (root.danger ? Theme.warn : Theme.accent) : Theme.line;
    background: touch.has-hover ? Theme.soft : Theme.card;
    accessible-role: button;
    accessible-label: root.says;
    accessible-action-default => { root.clicked(); }
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        sign: root.sign;
        size: root.side * 0.5;
        tint: touch.has-hover ? (root.danger ? Theme.warn : Theme.accent) : Theme.text;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// One line of a menu: a sign and words.
export component MenuItem inherits Rectangle {
    in property <string> sign;
    in property <string> text;
    in property <bool> danger: false;
    callback clicked;
    height: 44px;
    border-radius: 8px;
    background: touch.has-hover ? Theme.soft : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout { alignment: center; Icon { sign: root.sign; size: 18px; tint: root.danger ? Theme.warn : Theme.text; } }
        Text { text: root.text; color: root.danger ? Theme.warn : Theme.text; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}
