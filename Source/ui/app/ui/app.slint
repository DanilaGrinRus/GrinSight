import { Theme, ThemeName, Device, Settings, Files, Qr, Help, Find } from "theme.slint";
import { Card, Btn, Chip, Heading, Muted, Logo, Ground, Ask, Explained, OutLine, Icons, Icon, IconBtn, MenuItem } from "parts.slint";
import { ChatPage, ChatBox, ChatWindow, OpsPage, SecuritySheet, WordsSheet, OwnSheet, TorSheet, ChatLine, OpLine } from "pages.slint";
import { AddressLine, CreatePage, RestorePage, SendSheet, SlateSheet, SignSheet, ReceiveSheet, IncomingSheet, InvoiceSheet, ReleaseSheet, ContactSheet, OutputsSheet, Sheet, TextBox } from "flows.slint";

import "../fonts/Inter-Regular.otf";
import "../fonts/Inter-SemiBold.otf";
import "../fonts/DejaVuSansMono.ttf";
import "../fonts/DejaVuSansMono-Bold.ttf";

export { Theme, ThemeName, Device, Settings, Files, Qr, Help, Find, ChatLine, OpLine, ChatWindow }

export struct Waiting {
    who: string,
    what: string,
    action: string,
    second: string,
}

export struct Op {
    who: string,
    sub: string,
    amount: string,
    // 0 plain, 1 money came, 2 needs attention
    tone: int,
    // the payment's Slatepack text can be shown again
    show: bool,
}

export struct Contact {
    initial: string,
    name: string,
    last: string,
    attention: bool,
    // a payment to this contact is in a block (O63)
    traded: bool,
    // the owner compared the check code with this contact (O65)
    checked: bool,
    // O75: when the newest message was, and how many came since the
    // conversation was last open in this unlock
    time: string,
    unread: int,
}

// A line of the synchronisation block. tone: 0 plain, 1 good, 2 needs attention.
export struct SyncRow {
    label: string,
    value: string,
    tone: int,
}

// A trouble with two lines of help (О15).
export struct Problem {
    when: string,
    what: string,
    detail: string,
    help: string,
    open: bool,
    // the wallet's processes can be started anew for this one (O66)
    restart: bool,
}

// The whole path of following the chain, with the wallet's own numbers (О14).
// O73: the numbers of synchronisation, in a window of their own; what the
// chain process says of itself in its own words is behind one more press.
component SyncSheet inherits Sheet {
    in property <[SyncRow]> rows;
    // O75: the wallet's own starting point, made from the chain it verified
    // (O38), here and not on the main screen; O67: what a new one would give
    in property <string> point-note;
    in property <string> point-hint;
    in property <bool> point-good;
    in property <bool> point-busy;
    callback make-point();
    // what the chain process says about itself, a statement to a line
    in property <[string]> words;
    property <bool> raw: false;
    title: @tr("Details");
    card-width: 640px;
    for r in root.rows: HorizontalLayout {
        spacing: 14px;
        Text { text: r.label; color: Theme.muted; font-size: 14px; width: 200px; vertical-alignment: top; wrap: word-wrap; }
        Text {
            horizontal-stretch: 1;
            min-width: 80px;
            preferred-width: 80px;
            text: r.value;
            color: r.tone == 2 ? Theme.warn : r.tone == 1 ? Theme.text : Theme.muted;
            font-size: 14px;
            wrap: word-wrap;
        }
    }
    Rectangle { height: 1px; background: Theme.line; }
    HorizontalLayout {
        alignment: start;
        spacing: 8px;
        Btn { text: root.point-busy ? @tr("Making the point…") : @tr("Make my own starting point"); font-size: 13px; min-height: 34px; clicked => { if (!root.point-busy) { root.make-point(); } } }
        VerticalLayout { alignment: center; Ask { title: @tr("Make my own starting point"); text: @tr("The wallet starts from the point built into the program, and the history before that point is proved by sampling its work. The wallet can make a point of its own further up, from the chain it has checked itself since then. From the next unlock it starts from there, so the start is shorter.") + "\n\n" + @tr("Your point carries the proof of the built-in one: up to the built-in point the history stays proved, and from it to your point this wallet vouches. A point is made only from a chain that keeps that proof. Money, keys and history are not touched.") + "\n\n" + @tr("To carry the point to another device of yours: on the login screen there, Options → Own nodes and a point from another device, paste it whole. To go back to the built-in point: clear that field and save."); } }
    }
    if root.point-hint != "": Muted { text: root.point-hint; font-size: 13px; }
    if root.point-note != "": Text { text: root.point-note; color: root.point-good ? Theme.accent : Theme.warn; font-size: 13px; wrap: word-wrap; }
    if root.words.length > 0: Rectangle { height: 1px; background: Theme.line; }
    if root.words.length > 0: HorizontalLayout {
        alignment: start;
        Btn { text: root.raw ? @tr("Hide what the program reports") : @tr("What the program reports"); font-size: 13px; min-height: 34px; clicked => { root.raw = !root.raw; } }
    }
    if root.raw: VerticalLayout {
        spacing: 6px;
        for w in root.words: Text { text: w; color: Theme.muted; font-family: "DejaVu Sans Mono"; font-size: 13px; wrap: word-wrap; }
    }
}

// O73: what belongs to the program rather than to a payment, in one window.
component SettingsSheet inherits Sheet {
    callback open(int);
    callback bridges();
    title: @tr("Settings");
    Heading { text: @tr("Look"); }
    HorizontalLayout {
        spacing: 10px;
        Text { text: @tr("Theme"); color: Theme.text; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
        Btn { text: Theme.label; font-size: 14px; min-height: 38px; clicked => { Theme.next(); Settings.save(); } }
    }
    HorizontalLayout {
        spacing: 10px;
        Text { text: @tr("Language"); color: Theme.text; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
        Btn { text: "Русский"; primary: Settings.russian; font-size: 14px; min-height: 38px; clicked => { Settings.russian = true; Settings.save(); } }
        Btn { text: "English"; primary: !Settings.russian; font-size: 14px; min-height: 38px; clicked => { Settings.russian = false; Settings.save(); } }
    }
    Rectangle { height: 1px; background: Theme.line; }
    Heading { text: @tr("Safety"); }
    HorizontalLayout {
        spacing: 10px;
        Text { text: @tr("Change the password, see the 24 words again, delete the wallet from this computer"); color: Theme.muted; font-size: 14px; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
        VerticalLayout { alignment: center; Btn { text: @tr("Password and words"); font-size: 14px; min-height: 38px; clicked => { root.open(7); } } }
    }
    Rectangle { height: 1px; background: Theme.line; }
    Heading { text: @tr("Network"); }
    HorizontalLayout {
        spacing: 10px;
        Text { text: @tr("Bridges, for where Tor is blocked"); color: Theme.muted; font-size: 14px; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
        VerticalLayout { alignment: center; Btn { text: @tr("Tor bridges"); font-size: 14px; min-height: 38px; clicked => { root.bridges(); } } }
    }
    HorizontalLayout {
        spacing: 10px;
        Text { text: @tr("How far the wallet has checked the network, and what its programs say"); color: Theme.muted; font-size: 14px; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
        VerticalLayout { alignment: center; Btn { text: @tr("Details"); font-size: 14px; min-height: 38px; clicked => { root.open(15); } } }
    }
}

// What went wrong in this session, the newest first, and what to try (О15).
component ProblemsCard inherits Card {
    in property <[Problem]> problems;
    in property <string> more;
    callback restart();
    VerticalLayout {
        alignment: start;
        padding: 18px;
        spacing: 8px;
        Heading { text: @tr("Problems"); }
        if root.problems.length == 0: Muted { text: @tr("Nothing went wrong since the wallet was opened."); font-size: 12px; }
        for p in root.problems: VerticalLayout {
            spacing: 2px;
            Text { text: p.what; color: p.open ? Theme.warn : Theme.text; font-size: 13px; font-weight: 600; wrap: word-wrap; }
            Muted { text: p.when; font-size: 12px; }
            if p.detail != "": Text { text: p.detail; color: Theme.muted; font-family: "DejaVu Sans Mono"; font-size: 12px; wrap: char-wrap; }
            Muted { text: p.help; font-size: 12px; }
            if p.restart: HorizontalLayout { alignment: start; Btn { text: @tr("Restart the wallet"); font-size: 13px; min-height: 30px; clicked => { root.restart(); } } }
        }
        if root.more != "": Muted { text: root.more; font-size: 12px; }
    }
}

component Toggle inherits Rectangle {
    in-out property <bool> on;
    in property <string> label;
    width: 44px;
    height: 26px;
    border-radius: 13px;
    background: on ? Theme.accent : Theme.line;
    accessible-role: checkbox;
    accessible-checked: on;
    accessible-label: label;
    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        x: root.on ? parent.width - self.width - 3px : 3px;
        y: 3px;
        background: root.on ? Theme.on-accent : Theme.text;
        animate x { duration: 120ms; }
    }
    callback toggled(bool);
    TouchArea {
        clicked => { root.toggled(!root.on); }
    }
}

component OptionRow inherits Rectangle {
    in property <string> title;
    in property <string> note;
    // what the choice is for, in plain words (О36)
    in property <string> why;
    // the words of `why` are shown to whoever pressed the "?" (O41)
    in-out property <bool> asked: false;
    in property <bool> last: false;
    // O58: the title with its control on one line, the explanations under
    // them at the full width of the row - so that a narrow phone has room
    // for both, and nothing is pushed out of the screen
    VerticalLayout {
        padding: 10px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 10px;
            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                Text { text: root.title; color: Theme.text; font-size: 14px; font-weight: 600; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 0; }
                if root.why != "": VerticalLayout { alignment: center; Ask { title: root.title; text: root.why; } }
                Rectangle { horizontal-stretch: 1; }
            }
            @children
        }
        if root.note != "": Muted { text: root.note; font-size: 12px; }
    }
    if !last: Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
}

component Login inherits Rectangle {
    in-out property <bool> options-open: true;
    in-out property <bool> testnet: false;
    in-out property <bool> direct-post: false;
    // the two parts that can be switched off (O42)
    in property <bool> tor-on: true;
    in property <bool> nostr-on: true;
    callback switch-tor(bool);
    callback switch-nostr(bool);
    in property <string> start-point;
    in property <string> own-nodes;
    in property <string> version;
    in property <bool> live: false;
    in property <bool> has-profile: true;
    in property <bool> busy: false;
    in property <string> note;
    in-out property <string> error;
    property <string> password;
    callback enter(string);
    callback create();
    callback restore();
    callback options();
    // how Tor is reached, in words, and the window to change it
    in property <string> tor-way;
    callback tor-options();
    callback direct-changed(bool);
    property <bool> shone: false;
    init => { shone = true; }

    function submit() {
        if (!root.busy) {
            root.error = "";
            root.enter(root.password);
            root.password = "";
        }
    }

    Ground { }
    // the theme at the left, the language at the right; on a phone they get
    // their own strip above the content
    Btn {
        x: 16px;
        y: root.width < 600px ? 8px : 20px;
        width: self.min-width;
        height: 40px;
        text: @tr("Theme: ") + Theme.label;
        font-size: 13px;
        clicked => { Theme.next(); Settings.save(); }
    }
    Btn {
        x: parent.width - self.width - 16px;
        y: root.width < 600px ? 8px : 20px;
        width: self.min-width;
        height: 40px;
        text: Settings.russian ? "RU" : "EN";
        font-size: 13px;
        clicked => { Settings.russian = !Settings.russian; Settings.save(); }
    }
    Flickable {
        // scrolls on a small screen and when the keyboard is up
        y: root.width < 600px ? 56px : 0px;
        height: parent.height - self.y;
        width: parent.width;
        content-height: max(col.preferred-height, self.height);
        col := VerticalLayout {
            width: min(420px, parent.width - (parent.width < 360px ? 24px : 48px));
            x: (parent.width - self.width) / 2;
            height: parent.height;
            alignment: center;
            spacing: 12px;
            HorizontalLayout { alignment: center; Logo { width: 64px; height: 72px; } }
            HorizontalLayout {
                alignment: center;
                Text { text: "Grin"; color: Theme.text; font-size: 34px; font-weight: 700; }
                Text { text: "Sight"; color: #F5B800; font-size: 34px; font-weight: 700; }
            }
            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                Text {
                    text: "Revelio";
                    font-size: 20px;
                    font-weight: 700;
                    // A single shimmer when the window opens.
                    color: root.shone ? #F5B800 : #FFF2B3;
                    animate color { duration: 1800ms; easing: ease-out; }
                }
                Text { text: "for your coins"; color: Theme.muted; font-size: 20px; }
            }
            HorizontalLayout { alignment: center; Muted { text: @tr("Bear crafts"); font-size: 14px; } }
            Rectangle { height: 8px; }
            if root.note != "": Text { text: root.note; color: Theme.muted; font-size: 14px; wrap: word-wrap; horizontal-alignment: center; }
            if root.live && root.has-profile: Rectangle {
                height: 50px;
                border-radius: 12px;
                border-width: 1px;
                border-color: pw.has-focus ? Theme.accent : Theme.line;
                background: Theme.card;
                pw := TextInput {
                    x: 16px;
                    width: parent.width - 32px;
                    height: parent.height;
                    vertical-alignment: center;
                    input-type: InputType.password;
                    color: Theme.text;
                    font-size: 16px;
                    text <=> root.password;
                    accessible-label: @tr("Password");
                    accepted => { root.submit(); }
                    // Ctrl+V and its kin under a Cyrillic layout: the key gives «м», not "v"
                    key-pressed(event) => {
                        if (event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt) {
                            if (event.text == "м" || event.text == "М" || event.text == "\u{16}") { self.paste(); return accept; }
                            if (event.text == "ф" || event.text == "Ф" || event.text == "\u{1}") { self.select-all(); return accept; }
                        }
                        reject
                    }
                }
                if root.password == "": Text {
                    x: 16px;
                    height: parent.height;
                    vertical-alignment: center;
                    text: @tr("Password");
                    color: Theme.muted;
                    font-size: 16px;
                }
            }
            if root.error != "": Text { text: root.error; color: Theme.warn; font-size: 14px; wrap: word-wrap; horizontal-alignment: center; }
            if root.has-profile: Btn { text: root.busy ? @tr("Unlocking…") : @tr("Unlock"); primary: true; height: 52px; font-size: 16px; clicked => { root.submit(); } }
            if !root.has-profile: Btn { text: @tr("Create a wallet"); primary: true; height: 52px; font-size: 16px; clicked => { root.create(); } }
            // O58: the three buttons stand together above the options, so that
            // restoring is seen without scrolling, whatever the options take
            if !root.has-profile || !root.live: Btn { text: Device.phone ? @tr("Restore from words") : @tr("Restore a wallet from words"); height: 46px; clicked => { root.restore(); } }
            Btn { text: root.options-open ? @tr("Hide options") : @tr("Options"); height: 46px; clicked => { root.options-open = !root.options-open; } }
            if root.options-open: Card {
                VerticalLayout {
                    OptionRow {
                        title: @tr("Network");
                        why: @tr("Mainnet is real GRIN. Testnet is practice coins that are worth nothing.");
                        note: root.has-profile && root.live ? @tr("The network was chosen when the wallet was made") : @tr("For a new wallet");
                        HorizontalLayout {
                            alignment: center;
                            spacing: 4px;
                            Btn { text: "Mainnet"; font-size: 13px; primary: !root.testnet; clicked => { root.testnet = false; } }
                            Btn { text: "Testnet"; font-size: 13px; primary: root.testnet; clicked => { root.testnet = true; } }
                        }
                    }
                    // one row and one window for both: they are set together (О34)
                    OptionRow {
                        title: @tr("Own nodes and a point from another device");
                        why: @tr("Usually not needed. Own nodes: servers of yours the wallet also asks. A point from another device: a starting point your wallet made there, so that this one starts shorter.");
                        note: root.start-point + "\n" + root.own-nodes;
                        VerticalLayout { alignment: center; Btn { text: @tr("Set"); font-size: 13px; clicked => { root.options(); } } }
                    }
                    OptionRow {
                        title: "Tor";
                        why: @tr("Tor hides where you are on the network. Bridges are for places where Tor is blocked. Off: nothing of Tor is started — no payments to an address and no messages, and a transaction goes to the network directly, so the node sees your address.");
                        note: root.tor-on ? root.tor-way : @tr("Off · nodes will see the IP of ") + Device.of-this;
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: end;
                            if root.tor-on: VerticalLayout { alignment: center; Btn { text: @tr("Bridges"); font-size: 13px; clicked => { root.tor-options(); } } }
                            VerticalLayout { alignment: center; Toggle { on: root.tor-on; label: "Tor"; toggled(v) => { root.switch-tor(v); } } }
                        }
                    }
                    if root.tor-on: OptionRow {
                        title: @tr("Send directly if Tor fails");
                        why: @tr("On: if Tor does not work, a payment goes out without it and the node sees your address. Off: the wallet waits for Tor.");
                        note: (root.direct-post ? @tr("On") : @tr("Off")) + @tr(" · nodes will see the IP of ") + Device.of-this;
                        VerticalLayout { alignment: center; Toggle { on: root.direct-post; label: @tr("Send directly"); toggled(v) => { root.direct-post = v; root.direct-changed(v); } } }
                    }
                    OptionRow {
                        title: @tr("Messages (Nostr)");
                        why: @tr("Messages and payments to saved contacts travel through Nostr servers, over Tor. Off: the program for them is not started; payments go by hand or to an address.");
                        note: !root.nostr-on ? @tr("Off · payments to contacts go by hand") : root.tor-on ? @tr("On") : @tr("Do not work without Tor");
                        last: true;
                        VerticalLayout { alignment: center; Toggle { on: root.nostr-on; label: "Nostr"; toggled(v) => { root.switch-nostr(v); } } }
                    }
                }
            }
            HorizontalLayout { alignment: center; Muted { text: root.version; } }
        }
    }
}

// ---- the cards of the main screen; two columns on a wide window, one
// scrolling column on a phone

component BalanceCard inherits Card {
    in property <string> balance;
    in property <string> balance-note;
    in property <string> incoming;
    in property <string> verified;
    in property <string> verified-chip;
    in property <bool> verified-good;
    in property <bool> narrow;
    callback open(int);
    VerticalLayout {
        padding: 22px;
        spacing: 10px;
        // O73: how far the wallet has checked, above the money it speaks of;
        // pressed, it opens the details
        Rectangle {
            border-radius: 10px;
            background: state-touch.has-hover ? Theme.soft : transparent;
            accessible-role: button;
            accessible-label: root.verified-chip + " " + root.verified;
            accessible-action-default => { root.open(15); }
            state-touch := TouchArea { mouse-cursor: pointer; clicked => { root.open(15); } }
            // one layout under the area, so the row takes the height of what it shows
            VerticalLayout {
            if !root.narrow: HorizontalLayout {
                spacing: 10px;
                padding-top: 2px;
                padding-bottom: 2px;
                VerticalLayout { alignment: center; Chip { text: root.verified-chip; fg: root.verified-good ? Theme.accent : Theme.warn; fill: root.verified-good ? Theme.soft : Theme.warn-soft; height: 24px; } }
                Text { text: root.verified; color: Theme.muted; font-size: 13px; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                Text { text: @tr("Details") + " ›"; color: state-touch.has-hover ? Theme.accent : Theme.muted; font-size: 13px; vertical-alignment: center; }
            }
            // a phone: the mark and the way to the details on one line, the words under them
            if root.narrow: VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout { alignment: center; Chip { text: root.verified-chip; fg: root.verified-good ? Theme.accent : Theme.warn; fill: root.verified-good ? Theme.soft : Theme.warn-soft; height: 24px; } }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: @tr("Details") + " ›"; color: Theme.muted; font-size: 13px; vertical-alignment: center; }
                }
                Text { text: root.verified; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
            }
            }
        }
        Muted { text: @tr("Available"); font-weight: 600; }
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Text { text: root.balance; color: Theme.text; font-family: "DejaVu Sans Mono"; font-size: root.narrow ? 36px : 48px; font-weight: 700; vertical-alignment: bottom; }
            Text { text: "GRIN"; color: Theme.muted; font-family: "DejaVu Sans Mono"; font-size: 20px; vertical-alignment: bottom; }
        }
        HorizontalLayout {
            spacing: 10px;
            Muted { text: root.balance-note; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
            // what the money is made of, and the owner's say over it (O51)
            VerticalLayout { alignment: center; Btn { text: @tr("Outputs"); font-size: 13px; min-height: 32px; clicked => { root.open(13); } } }
        }
        if root.incoming != "": HorizontalLayout { alignment: start; Chip { text: root.incoming; text-size: 15px; } }
        HorizontalLayout {
            spacing: 10px;
            Btn { text: @tr("Send"); primary: true; height: 52px; horizontal-stretch: 1; font-size: 16px; clicked => { root.open(1); } }
            Btn { text: @tr("Receive"); height: 52px; horizontal-stretch: 1; font-size: 16px; clicked => { root.open(4); } }
        }
    }
}

component WaitCard inherits Card {
    in property <[Waiting]> waiting;
    in property <bool> narrow;
    in property <string> note;
    callback act(int, bool);
    edge: Theme.warn;
    VerticalLayout {
        padding: 18px;
        spacing: 10px;
        HorizontalLayout {
            Heading { text: @tr("Waiting for you"); horizontal-stretch: 1; }
            Chip { text: root.waiting.length; fg: #141000; fill: Theme.warn; height: 24px; }
        }
        // what the wallet refused when asked from this list
        if root.note != "": Text { text: root.note; color: Theme.warn; font-size: 13px; wrap: word-wrap; }
        for w[i] in root.waiting: Rectangle {
            background: Theme.bg;
            border-radius: 12px;
          // a layout around the two forms, so the row takes their height
          VerticalLayout {
            if !root.narrow: HorizontalLayout {
                padding: 10px;
                spacing: 10px;
                Text { text: w.who + " " + w.what; color: Theme.text; font-size: 14px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                Btn { text: w.action; primary: true; font-size: 13px; height: 38px; clicked => { root.act(i, true); } }
                if w.second != "": Btn { text: w.second; font-size: 13px; height: 38px; clicked => { root.act(i, false); } }
            }
            if root.narrow: VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Text { text: w.who + " " + w.what; color: Theme.text; font-size: 14px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    Btn { text: w.action; primary: true; font-size: 13px; height: 40px; horizontal-stretch: 1; clicked => { root.act(i, true); } }
                    if w.second != "": Btn { text: w.second; font-size: 13px; height: 40px; horizontal-stretch: 1; clicked => { root.act(i, false); } }
                }
            }
          }
        }
    }
}

component RequisitesCard inherits Card {
    in property <[string]> address-groups;
    in property <string> address-full;
    in property <string> phrase;
    in property <string> phrase-label;
    in property <bool> identity-made;
    callback open(int);
    callback make-identity();
    property <bool> copied: false;
    VerticalLayout {
        padding: 18px;
        spacing: 8px;
        Heading { text: @tr("My details"); }
        Muted { text: @tr("Wallet address"); font-size: 12px; }
        AddressLine { groups: root.address-groups; full: root.address-full; copyable: root.address-full != ""; with-qr: true; }
        Muted { text: root.phrase-label; font-size: 12px; }
        Rectangle {
            background: Theme.bg;
            border-radius: 10px;
            HorizontalLayout { padding: 10px; Text { text: root.phrase; color: Theme.text; font-family: "DejaVu Sans Mono"; font-size: 12px; wrap: char-wrap; } }
        }
        HorizontalLayout {
            alignment: start;
            spacing: 6px;
            if !root.identity-made: Btn { text: @tr("Create a message key"); font-size: 13px; clicked => { root.make-identity(); } }
            if root.identity-made: Btn {
                text: root.copied ? @tr("Key copied") : @tr("Copy the key");
                font-size: 13px;
                clicked => { key-box.select-all(); key-box.copy(); key-box.clear-selection(); root.copied = true; }
            }
        }
    }
    // the key, invisible, only to put it on the clipboard
    key-box := TextInput { text: root.phrase; read-only: true; width: 0px; height: 0px; visible: false; }
}

// A contact's first letter in a circle.
component Avatar inherits Rectangle {
    in property <string> letter;
    in property <length> side: 38px;
    width: root.side;
    height: root.side;
    border-radius: root.side / 2;
    background: Theme.line;
    Text { text: root.letter; color: Theme.text; font-size: root.side * 0.4; font-weight: 600; }
}

// O75: the contacts on a phone: a line each, its time and what is new;
// "⋯" opens the actions on it from the bottom of the screen.
component ContactsCard inherits Card {
    in property <[Contact]> contacts;
    callback open(int);
    callback chat(int);
    callback menu(int);
    VerticalLayout {
        padding: 16px;
        spacing: 4px;
        alignment: start;
        HorizontalLayout {
            spacing: 8px;
            Heading { text: @tr("Your contacts"); font-size: 16px; vertical-alignment: center; horizontal-stretch: 1; }
            IconBtn { sign: Icons.plus; says: @tr("Add a contact"); side: 40px; clicked => { root.open(6); } }
        }
        if root.contacts.length == 0: Muted { text: @tr("No contacts yet."); font-size: 14px; }
        for c[i] in root.contacts: Rectangle {
            height: 64px;
            border-radius: 10px;
            background: row.has-hover ? Theme.soft : transparent;
            row := TouchArea { mouse-cursor: pointer; clicked => { root.chat(i); } }
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout { alignment: center; Avatar { letter: c.initial; side: 42px; } }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: c.checked ? c.name + " ✓" : c.name; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
                        Text { text: c.time; color: Theme.muted; font-size: 12px; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: c.last; color: c.attention ? Theme.warn : c.unread > 0 ? Theme.text : Theme.muted; font-size: 13px; overflow: elide; horizontal-stretch: 1; }
                        if c.unread > 0: Rectangle {
                            min-width: 22px;
                            height: 22px;
                            border-radius: 11px;
                            background: Theme.accent;
                            HorizontalLayout {
                                padding-left: 7px;
                                padding-right: 7px;
                                Text { text: c.unread; color: Theme.on-accent; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                }
                VerticalLayout { alignment: center; IconBtn { sign: Icons.more; says: @tr("Actions on the contact"); side: 40px; clicked => { root.menu(i); } } }
            }
        }
        if root.contacts.length > 0: HorizontalLayout { alignment: start; Btn { text: @tr("All contacts") + " · " + root.contacts.length; font-size: 13px; clicked => { root.open(14); } } }
        if root.contacts.length == 0: HorizontalLayout { alignment: start; Btn { text: @tr("Add a list"); font-size: 13px; clicked => { root.open(14); } } }
    }
}


// O75: what is said of a contact under its name in a conversation.
component ContactState inherits Text {
    in property <Contact> c;
    in property <string> note;
    text: root.note != "" ? root.note
        : root.c.checked && root.c.traded ? @tr("check code compared · you have paid them")
        : root.c.checked ? @tr("check code compared")
        : root.c.traded ? @tr("you have paid them · check code not compared")
        : @tr("check code not compared");
    color: root.note != "" ? Theme.warn : Theme.muted;
    font-size: 12px;
    overflow: elide;
}

// O75 (was O63): contacts on the left on a ground of their own, the
// conversation with the chosen one on the right: its name and what is
// said of it, the main action, the rest under "⋯"; the actions on a
// contact are signs in its line once it is chosen.
component ContactsPanel inherits Card {
    in property <[Contact]> contacts;
    in property <string> chat-name;
    in property <string> chat-note;
    in property <[ChatLine]> chat-lines;
    in property <bool> chat-busy;
    in property <string> chat-error;
    in property <bool> chat-can-write;
    // the contact whose conversation is shown; -1: none chosen yet - as the
    // program says, so that a deleted contact is not left chosen
    in property <int> picked: -1;
    // why a window for a conversation did not open (O70)
    in property <string> apart-note;
    property <string> search;
    property <Contact> current: root.picked >= 0 && root.picked < root.contacts.length ? root.contacts[root.picked] : { name: "", initial: "" };
    callback open(int);
    callback chat(int);
    callback pay(int);
    callback ask-remove(int);
    callback apart(int);
    callback edit(int);
    callback chat-send(string);
    min-height: 440px;
    clip: true;
    HorizontalLayout {
        // the contacts, on a ground of their own
        Rectangle {
            width: 276px;
            background: Theme.card.mix(Theme.bg, 0.45);
            border-top-left-radius: 18px;
            border-bottom-left-radius: 18px;
            VerticalLayout {
                padding: 14px;
                padding-right: 10px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Heading { text: @tr("Your contacts"); font-size: 16px; vertical-alignment: center; horizontal-stretch: 1; }
                    IconBtn { sign: Icons.plus; says: @tr("Add a contact"); side: 34px; clicked => { root.open(6); } }
                }
                if root.contacts.length > 0: Rectangle {
                    height: 38px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: find.has-focus ? Theme.accent : Theme.line;
                    background: Theme.bg;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        VerticalLayout { alignment: center; Icon { sign: Icons.find; size: 16px; tint: Theme.muted; } }
                        Rectangle {
                            horizontal-stretch: 1;
                            find := TextInput {
                                y: (parent.height - self.height) / 2;
                                width: parent.width;
                                height: self.preferred-height;
                                single-line: true;
                                color: Theme.text;
                                font-size: 14px;
                                text <=> root.search;
                                accessible-label: @tr("Find a contact");
                            }
                            if root.search == "": Text { text: @tr("Find by name"); color: Theme.muted; font-size: 14px; vertical-alignment: center; horizontal-alignment: left; width: parent.width; height: parent.height; }
                        }
                    }
                }
                if root.contacts.length == 0: Muted { text: @tr("No contacts yet."); font-size: 14px; }
                if root.contacts.length == 0: Btn { text: @tr("Add a contact"); primary: true; font-size: 14px; clicked => { root.open(6); } }
                if root.contacts.length == 0: Btn { text: @tr("Add a list"); font-size: 14px; clicked => { root.open(14); } }
                Flickable {
                    vertical-stretch: 1;
                    content-height: rows.preferred-height;
                    rows := VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        spacing: 2px;
                        for c[i] in root.contacts: Rectangle {
                            visible: root.search == "" || Find.matches(c.name, root.search);
                            height: self.visible ? 60px : 0px;
                            border-radius: 10px;
                            background: root.picked == i ? Theme.soft : row.has-hover ? Theme.soft.with-alpha(0.08) : transparent;
                            row := TouchArea { mouse-cursor: pointer; clicked => { root.chat(i); } }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 6px;
                                spacing: 10px;
                                VerticalLayout { alignment: center; Avatar { letter: c.initial; } }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: c.checked ? c.name + " ✓" : c.name; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
                                        if root.picked != i: Text { text: c.time; color: Theme.muted; font-size: 12px; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: c.last; color: c.attention ? Theme.warn : c.unread > 0 ? Theme.text : Theme.muted; font-size: 13px; overflow: elide; horizontal-stretch: 1; }
                                        if c.unread > 0 && root.picked != i: Rectangle {
                                            min-width: 20px;
                                            height: 20px;
                                            border-radius: 10px;
                                            background: Theme.accent;
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                Text { text: c.unread; color: Theme.on-accent; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                }
                                // the actions on the chosen contact, as signs
                                if root.picked == i: VerticalLayout { alignment: center; IconBtn { sign: Icons.send; says: @tr("Send GRIN to the contact"); side: 30px; clicked => { root.pay(i); } } }
                                if root.picked == i: VerticalLayout { alignment: center; IconBtn { sign: Icons.edit; says: @tr("Change the contact's details"); side: 30px; clicked => { root.edit(i); } } }
                                if root.picked == i: VerticalLayout { alignment: center; IconBtn { sign: Icons.trash; says: @tr("Delete the contact"); danger: true; side: 30px; clicked => { root.ask-remove(i); } } }
                            }
                        }
                    }
                }
                if root.apart-note != "": Text { text: root.apart-note; color: Theme.warn; font-size: 13px; wrap: word-wrap; }
                if root.contacts.length > 0: Btn { text: @tr("All contacts") + " · " + root.contacts.length; font-size: 13px; min-height: 38px; clicked => { root.open(14); } }
            }
        }
        Rectangle { width: 1px; background: Theme.line; }
        // the conversation
        VerticalLayout {
            horizontal-stretch: 1;
            if root.picked < 0: VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                padding: 28px;
                spacing: 12px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 52px;
                        height: 52px;
                        border-radius: 26px;
                        background: Theme.soft;
                        Icon { x: 14px; y: 14px; sign: Icons.send; size: 24px; tint: Theme.accent; }
                    }
                }
                Text { text: root.contacts.length == 0 ? @tr("The conversation will be here") : @tr("Choose a contact"); color: Theme.text; font-size: 17px; font-weight: 600; horizontal-alignment: center; }
                Muted {
                    text: root.contacts.length == 0
                        ? @tr("Add a contact by their message key (npub1…): you can write to them and pay them by name. Messages travel over Tor.")
                        : @tr("Choose a contact on the left to see the conversation.");
                    font-size: 14px;
                    horizontal-alignment: center;
                }
            }
            if root.picked >= 0: Rectangle {
                height: 66px;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 14px;
                    spacing: 10px;
                    VerticalLayout { alignment: center; Avatar { letter: root.current.initial; side: 40px; } }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: root.current.checked ? root.chat-name + " ✓" : root.chat-name; color: Theme.text; font-size: 16px; font-weight: 700; overflow: elide; }
                        ContactState { c: root.current; note: root.chat-note; }
                    }
                    VerticalLayout { alignment: center; Btn { text: @tr("Send GRIN"); primary: true; font-size: 13px; min-height: 38px; clicked => { root.pay(root.picked); } } }
                    VerticalLayout { alignment: center; IconBtn { sign: Icons.window; says: @tr("Open the conversation in a window of its own"); side: 38px; clicked => { root.apart(root.picked); } } }
                    VerticalLayout { alignment: center; IconBtn { sign: Icons.more; says: @tr("More"); side: 38px; clicked => { menu.show(); } } }
                }
                menu := PopupWindow {
                    x: parent.width - 270px;
                    y: 58px;
                    width: 256px;
                    Rectangle {
                        background: Theme.card.mix(Theme.bg, 0.45);
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.line;
                        VerticalLayout {
                            padding: 6px;
                            MenuItem { sign: Icons.send; text: @tr("Send GRIN to the contact"); clicked => { root.pay(root.picked); } }
                            MenuItem { sign: Icons.ask; text: @tr("Ask for GRIN"); clicked => { root.open(4); } }
                            MenuItem { sign: Icons.shield; text: @tr("Compare the check code"); clicked => { root.edit(root.picked); } }
                            MenuItem { sign: Icons.edit; text: @tr("Change the contact's details"); clicked => { root.edit(root.picked); } }
                            Rectangle { height: 1px; background: Theme.line; }
                            MenuItem { sign: Icons.trash; text: @tr("Delete the contact…"); danger: true; clicked => { root.ask-remove(root.picked); } }
                        }
                    }
                }
            }
            if root.picked >= 0: Rectangle { height: 1px; background: Theme.line; }
            if root.picked >= 0: VerticalLayout {
                vertical-stretch: 1;
                padding: 14px;
                padding-top: 8px;
                ChatBox {
                    vertical-stretch: 1;
                    flat: true;
                    name: root.chat-name;
                    lines: root.chat-lines;
                    busy: root.chat-busy;
                    error: root.chat-error;
                    can-write: root.chat-can-write;
                    send(t) => { root.chat-send(t); }
                }
            }
        }
    }
}

// O63: every contact, the mark of those the owner has paid, deleting one
// or all, and adding many at once: keys one a line, addresses one a line,
// line to line.
component ContactsSheet inherits Sheet {
    in property <[Contact]> contacts;
    in property <string> note;
    in property <bool> busy;
    in property <string> error;
    callback remove(int);
    callback remove-all();
    callback add-list(string, string);
    property <int> asking: -1;
    property <bool> asking-all: false;
    property <bool> adding: false;
    property <string> keys;
    property <string> addresses;
    title: @tr("All contacts");
    card-width: 620px;
    if root.contacts.length == 0: Muted { text: @tr("No contacts yet"); }
    for c[i] in root.contacts: Rectangle {
        min-height: 44px;
        border-radius: 10px;
        background: Theme.bg;
        HorizontalLayout {
            padding: 8px;
            padding-left: 12px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: c.name; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
                if c.checked: Muted { text: @tr("✓ checked: the check code was compared"); font-size: 12px; }
                if c.traded: Muted { text: @tr("you have paid them: a payment is in a block"); font-size: 12px; }
            }
            if root.asking != i: VerticalLayout { alignment: center; Btn { text: @tr("Delete"); font-size: 13px; min-height: 28px; clicked => { root.asking = i; } } }
            if root.asking == i: VerticalLayout { alignment: center; Btn { text: @tr("Delete with the conversation"); primary: true; font-size: 13px; min-height: 28px; clicked => { root.asking = -1; root.remove(i); } } }
            if root.asking == i: VerticalLayout { alignment: center; Btn { text: @tr("No"); font-size: 13px; min-height: 28px; clicked => { root.asking = -1; } } }
        }
    }
    if root.adding: Muted { text: @tr("Message keys one a line; wallet addresses one a line, each on the line of its key (a line may be left empty). The contacts get the names “Contact 1”, “Contact 2”…"); font-size: 12px; }
    if root.adding: TextBox { label: @tr("Message keys (npub1…)"); hint: "npub1…"; text <=> root.keys; box-height: 90px; }
    if root.adding: TextBox { label: @tr("Wallet addresses (grin1…), optional"); hint: "grin1…"; text <=> root.addresses; box-height: 90px; }
    if root.adding: Btn { text: root.busy ? @tr("Saving…") : @tr("Add these contacts"); primary: true; height: 44px; clicked => { if (!root.busy) { root.add-list(root.keys, root.addresses); } } }
    if root.note != "": Muted { text: root.note; font-size: 12px; }
    if root.error != "": Text { text: root.error; color: Theme.warn; font-size: 14px; wrap: word-wrap; }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Btn { text: root.adding ? @tr("Close the list to add") : @tr("Add a list"); font-size: 13px; clicked => { root.adding = !root.adding; } }
        if root.contacts.length > 0 && !root.asking-all: Btn { text: @tr("Delete all"); font-size: 13px; clicked => { root.asking-all = true; } }
        if root.asking-all: Btn { text: @tr("Delete every contact and conversation"); primary: true; font-size: 13px; clicked => { root.asking-all = false; root.remove-all(); } }
        if root.asking-all: Btn { text: @tr("No"); font-size: 13px; clicked => { root.asking-all = false; } }
    }
    Btn { text: @tr("Done"); primary: true; height: 46px; clicked => { root.close(); } }
}

component LinkCard inherits Card {
    in property <string> tor-line;
    in property <bool> link-good;
    in property <string> tx-line;
    in property <bool> tx-good;
    in property <string> addr-line;
    in property <bool> addr-good;
    in property <string> auto-receive;
    in property <bool> auto-on;
    in property <bool> auto-known;
    callback set-auto(bool);
    callback bridges();
    // the stages of following the network, in the order they happen (О33)
    // how each Tor stands: 0 not in use, 3 coming up, 1 working, 2 needs attention (О35)
    in property <int> tor-tone;
    in property <int> tx-tone;
    in property <int> addr-tone;
    in property <[SyncRow]> stages;
    // what the chain process says that is not a stage, as it said it
    in property <[string]> rest;
    in-out property <bool> details;
    property <bool> asked: false;
    // the two parts that can be switched off, and the one being asked about: 0 none, 1 Tor, 2 Nostr (O42)
    in property <bool> tor-on: true;
    in property <bool> nostr-on: true;
    callback switch-tor(bool);
    callback switch-nostr(bool);
    property <int> ask-part: 0;
    property <bool> parts-asked: false;
    VerticalLayout {
        padding: 18px;
        spacing: 10px;
        HorizontalLayout {
            Heading { text: @tr("Connection and synchronisation"); vertical-alignment: center; }
            VerticalLayout { alignment: center; padding-left: 8px; Ask { title: @tr("Connection and synchronisation"); text: @tr("Through Tor everything goes slower. That is the price of privacy, not a fault.") + "\n\n" + @tr("A faint ring: not begun. A ring: under way. A filled mark: done. The warning colour: needs your attention."); } }
            Rectangle { horizontal-stretch: 1; }
            if root.tor-on: Btn { text: @tr("Tor bridges"); font-size: 13px; min-height: 30px; clicked => { root.bridges(); } }
        }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout { padding-top: 5px; alignment: start; Rectangle { width: 9px; height: 9px; border-radius: 4.5px; border-width: 1.5px; border-color: root.tor-tone == 2 ? Theme.state-alert : root.tor-tone == 0 ? Theme.state-off.with-alpha(0.7) : root.tor-tone == 3 ? Theme.state-busy : Theme.state-ok; background: root.tor-tone == 1 ? Theme.state-ok : root.tor-tone == 2 ? Theme.state-alert : transparent; } }
            Text { text: root.tor-line; color: Theme.text; font-size: 13px; wrap: word-wrap; horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout { padding-top: 5px; alignment: start; Rectangle { width: 9px; height: 9px; border-radius: 4.5px; border-width: 1.5px; border-color: root.tx-tone == 2 ? Theme.state-alert : root.tx-tone == 0 ? Theme.state-off.with-alpha(0.7) : root.tx-tone == 3 ? Theme.state-busy : Theme.state-ok; background: root.tx-tone == 1 ? Theme.state-ok : root.tx-tone == 2 ? Theme.state-alert : transparent; } }
            Text { text: root.tx-line; color: Theme.text; font-size: 13px; wrap: word-wrap; horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout { padding-top: 5px; alignment: start; Rectangle { width: 9px; height: 9px; border-radius: 4.5px; border-width: 1.5px; border-color: root.addr-tone == 2 ? Theme.state-alert : root.addr-tone == 0 ? Theme.state-off.with-alpha(0.7) : root.addr-tone == 3 ? Theme.state-busy : Theme.state-ok; background: root.addr-tone == 1 ? Theme.state-ok : root.addr-tone == 2 ? Theme.state-alert : transparent; } }
            Text { text: root.addr-line; color: Theme.text; font-size: 13px; wrap: word-wrap; horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 8px;
            Muted { text: "Tor"; font-size: 12px; vertical-alignment: center; }
            VerticalLayout { alignment: center; Toggle { on: root.tor-on; label: "Tor"; toggled(v) => { root.ask-part = root.ask-part == 1 ? 0 : 1; } } }
            Rectangle { width: 8px; }
            Muted { text: "Nostr"; font-size: 12px; vertical-alignment: center; }
            VerticalLayout { alignment: center; Toggle { on: root.nostr-on; label: "Nostr"; toggled(v) => { root.ask-part = root.ask-part == 2 ? 0 : 2; } } }
            VerticalLayout { alignment: center; padding-left: 4px; Ask { title: "Tor · Nostr"; text: @tr("Each of the two can be switched off, in case you need to. Off means its program does not run. Tor is switched at once and the wallet stays open; for Nostr the wallet locks and asks for the password again."); } }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.ask-part != 0: Rectangle {
            background: Theme.bg;
            border-radius: 10px;
            VerticalLayout {
                padding: 12px;
                spacing: 10px;
                Text {
                    text: root.ask-part == 1
                        ? (root.tor-on
                            ? @tr("Switch Tor off? Without it there are no payments to an address and no messages, and a transaction goes to the network directly: the node sees the address of your device. It takes effect at once; the wallet stays open.")
                            : @tr("Switch Tor on? It takes effect at once; Tor needs a little time to come up."))
                        : (root.nostr-on
                            ? @tr("Switch Nostr off? Without it there are no messages and no payments to saved contacts; everything else works. The wallet locks and asks for the password again.")
                            : @tr("Switch Nostr on? The wallet locks and asks for the password again."));
                    color: root.ask-part == 1 && root.tor-on ? Theme.warn : Theme.text;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Btn {
                        text: (root.ask-part == 1 ? root.tor-on : root.nostr-on) ? @tr("Switch off") : @tr("Switch on");
                        primary: true;
                        font-size: 12px;
                        min-height: 30px;
                        clicked => {
                            if (root.ask-part == 1) { root.switch-tor(!root.tor-on); } else { root.switch-nostr(!root.nostr-on); }
                            root.ask-part = 0;
                        }
                    }
                    Btn { text: @tr("Cancel"); font-size: 13px; min-height: 30px; clicked => { root.ask-part = 0; } }
                }
            }
        }
        if root.stages.length > 0: Rectangle { height: 1px; background: Theme.line; }
        // a filled mark: done (or, in the warning colour, needs attention);
        // a ring: under way; a faint ring: not begun. Shape as well as colour.
        for r in root.stages: HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                padding-top: 4px;
                alignment: start;
                Rectangle {
                    width: 9px;
                    height: 9px;
                    border-radius: 4.5px;
                    border-width: 1.5px;
                    border-color: r.tone == 2 ? Theme.state-alert : r.tone == 0 ? Theme.state-off.with-alpha(0.7) : r.tone == 3 ? Theme.state-busy : Theme.state-ok;
                    background: r.tone == 1 ? Theme.state-ok : r.tone == 2 ? Theme.state-alert : transparent;
                }
            }
            Muted { text: r.label; font-size: 12px; width: 112px; vertical-alignment: top; }
            Text { text: r.value; color: r.tone == 2 ? Theme.warn : r.tone == 0 ? Theme.muted : Theme.text; font-size: 13px; wrap: word-wrap; horizontal-stretch: 1; min-width: 60px; preferred-width: 60px; }
        }
        for w in root.rest: Text { text: w; color: Theme.warn; font-size: 13px; wrap: word-wrap; }
        Muted { text: @tr("Payment delivery"); font-size: 12px; }
        HorizontalLayout {
            spacing: 6px;
            // the choice shows at once; whether Tor works now is said under it
            Btn { text: "Tor"; primary: root.tor-on && !Settings.by-hand; font-size: 13px; horizontal-stretch: 1; clicked => { Settings.by-hand = false; Settings.save(); } }
            Btn { text: @tr("By hand"); primary: Settings.by-hand || !root.tor-on; font-size: 13px; horizontal-stretch: 1; clicked => { Settings.by-hand = true; Settings.save(); } }
            // not in this wallet yet: shown, not pressed
            Rectangle {
                horizontal-stretch: 1;
                min-height: 44px;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.line;
                opacity: 0.55;
                accessible-role: text;
                accessible-label: @tr("GlauxMail: soon");
                VerticalLayout {
                    alignment: center;
                    Text { text: "GlauxMail"; color: Theme.muted; font-size: 13px; font-weight: 600; horizontal-alignment: center; }
                    Text { text: @tr("soon"); color: Theme.muted; font-size: 10px; horizontal-alignment: center; }
                }
            }
        }
        Muted {
            font-size: 12px;
            min-height: 30px;
            text: !root.tor-on ? @tr("Tor is switched off: every payment is a text you pass on yourself.") : Settings.by-hand ? @tr("By hand: every payment is a text you pass on yourself.") : (root.link-good || root.addr-good) ? @tr("Tor: a payment to a contact or to a grin1 address is delivered by itself.") : @tr("Tor is chosen, but delivery does not work now: payments go by hand.");
        }
        Rectangle { height: 1px; background: Theme.line; }
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1;
                Text { text: @tr("Auto-receive"); color: Theme.text; font-size: 14px; }
                // room for two lines, so a longer wording moves nothing
                Muted { text: root.auto-receive; font-size: 12px; min-height: 30px; vertical-alignment: top; }
            }
            // the switch keeps its place even while its state is not known
            VerticalLayout { alignment: center; width: 44px; if root.auto-known: Toggle { on: root.auto-on; label: @tr("Auto-receive"); toggled(v) => { root.set-auto(v); } } }
        }
    }
}

component OpsCard inherits Card {
    in property <[Op]> ops;
    callback all();
    callback show(int);
    VerticalLayout {
        alignment: start;
        padding: 18px;
        spacing: 0px;
        Heading { text: @tr("Recent payments"); height: 28px; }
        if root.ops.length == 0: Muted { text: @tr("No payments yet"); height: 28px; }
        for op[i] in root.ops: VerticalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: op.who; color: Theme.text; font-size: 14px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                // a small sign, not a button with words: the text of this payment, again
                if op.show: Rectangle {
                    width: 28px;
                    height: 24px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: show-touch.has-hover ? Theme.accent : Theme.line;
                    accessible-role: button;
                    accessible-label: @tr("Show the Slatepack text");
                    accessible-action-default => { root.show(i); }
                    Text { text: "≡"; font-family: "DejaVu Sans Mono"; font-size: 15px; color: show-touch.has-hover ? Theme.accent : Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                    show-touch := TouchArea { clicked => { root.show(i); } }
                }
                Text { text: op.amount; font-family: "DejaVu Sans Mono"; font-size: 14px; font-weight: 700; color: op.tone == 1 ? Theme.accent : op.tone == 2 ? Theme.warn : Theme.text; }
            }
            Text { text: op.sub; color: op.tone == 2 ? Theme.warn : Theme.muted; font-size: 13px; wrap: word-wrap; }
        }
        HorizontalLayout { alignment: start; padding-top: 6px; Btn { text: @tr("All payments"); font-size: 13px; clicked => { root.all(); } } }
    }
}

component Dashboard inherits Rectangle {
    in property <string> wallet-name;
    in property <string> network;
    in property <string> balance;
    in property <string> balance-note;
    in property <string> incoming;
    in property <string> verified;
    in property <string> verified-chip;
    in property <bool> verified-good;
    in property <[string]> address-groups;
    in property <string> phrase;
    in property <string> phrase-label;
    in property <[Waiting]> waiting;
    in property <string> wait-note;
    in property <[Contact]> contacts;
    in property <[Op]> ops;
    in property <string> tor-line;
    in property <bool> link-good;
    in property <string> tx-line;
    in property <bool> tx-good;
    in property <string> addr-line;
    in property <bool> addr-good;
    in property <string> auto-receive;
    in property <bool> identity-made;
    in property <bool> auto-on;
    in property <bool> auto-known;
    in property <string> address-full;
    in property <string> app-version;
    in property <[SyncRow]> sync-rows;
    in property <[string]> sync-words;
    in property <int> tor-tone;
    in property <int> tx-tone;
    in property <int> addr-tone;
    in property <[SyncRow]> sync-stages;
    in property <[string]> sync-rest;
    in property <bool> tor-on: true;
    in property <bool> nostr-on: true;
    callback switch-tor(bool);
    callback switch-nostr(bool);
    in property <[Problem]> problems;
    in property <string> problems-more;
    callback leave();
    callback restart-wallet();
    callback act(int, bool);
    callback open(int);
    callback chat(int);
    callback make-identity();
    callback set-auto(bool);
    callback op-show(int);
    callback tor-options();
    callback all-ops();
    // the conversation on the main screen (O63)
    in property <string> chat-name;
    in property <string> chat-note;
    in property <[ChatLine]> chat-lines;
    in property <bool> chat-busy;
    in property <string> chat-error;
    in property <bool> chat-can-write;
    callback chat-send(string);
    callback contact-pay(int);
    callback contact-remove(int);
    // O75: deleting a contact is asked in a window of its own; a phone's "⋯"
    callback ask-remove(int);
    callback contact-menu(int);
    callback contact-apart(int);
    callback contact-edit(int);
    in property <string> apart-note;
    // the contact whose conversation is shown when the screen opens; -1: none
    in property <int> picked-at-start: -1;
    property <bool> narrow: root.width < 760px;


    Ground { }
    VerticalLayout {
        padding: root.narrow ? 12px : 18px;
        spacing: root.narrow ? 10px : 14px;

        HorizontalLayout {
            height: 46px;
            spacing: root.narrow ? 6px : 10px;
            Logo { width: 30px; }
            if !root.narrow: HorizontalLayout {
                spacing: 0px;
                Text { text: "Grin"; color: Theme.text; font-size: 16px; font-weight: 700; vertical-alignment: center; }
                Text { text: "Sight"; color: #F5B800; font-size: 16px; font-weight: 700; vertical-alignment: center; }
            }
            if !root.narrow: Muted { text: root.wallet-name; vertical-alignment: center; wrap: no-wrap; }
            VerticalLayout { alignment: center; Chip { text: root.network; fg: Theme.muted; fill: Theme.soft; height: 24px; } }
            if !root.narrow: Muted { text: root.app-version; font-size: 12px; vertical-alignment: center; wrap: no-wrap; }
            Rectangle { horizontal-stretch: 1; }
            // what belongs to the program rather than to a payment sits together here (О34)
            // O63: the numbers of synchronisation, for when something is looked into
            // O73: what belongs to the program rather than to a payment is in one window
            Btn { text: @tr("Settings"); font-size: 13px; clicked => { root.open(16); } }
            Btn { text: @tr("Lock"); font-size: 13px; clicked => { root.leave(); } }
        }

        if !root.narrow: Flickable {
          vertical-stretch: 1;
          content-width: self.width;
          content-height: wide.preferred-height;
          wide := HorizontalLayout {
            width: parent.width;
            spacing: 14px;
            alignment: stretch;
            VerticalLayout {
                horizontal-stretch: 2;
                // the width is shared two to one, whatever the texts would like
                preferred-width: 200px;
                spacing: 14px;
                BalanceCard { vertical-stretch: 0; balance: root.balance; balance-note: root.balance-note; incoming: root.incoming; verified: root.verified; verified-chip: root.verified-chip; verified-good: root.verified-good; narrow: false; open(n) => { root.open(n); } }
                if root.waiting.length > 0: WaitCard { vertical-stretch: 0; waiting: root.waiting; note: root.wait-note; narrow: false; act(i, yes) => { root.act(i, yes); } }
                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: 14px;
                    RequisitesCard { horizontal-stretch: 1; address-groups: root.address-groups; address-full: root.address-full; phrase: root.phrase; phrase-label: root.phrase-label; identity-made: root.identity-made; open(n) => { root.open(n); } make-identity => { root.make-identity(); } }
                    ProblemsCard { horizontal-stretch: 1; problems: root.problems; more: root.problems-more; restart => { root.restart-wallet(); } }
                }
                // the last card of each column takes what is left, so that both columns end at one line (O44)
                ContactsPanel {
                    vertical-stretch: 1;
                    picked: root.picked-at-start;
                    contacts: root.contacts;
                    chat-name: root.chat-name;
                    chat-note: root.chat-note;
                    chat-lines: root.chat-lines;
                    chat-busy: root.chat-busy;
                    chat-error: root.chat-error;
                    chat-can-write: root.chat-can-write;
                    apart-note: root.apart-note;
                    open(n) => { root.open(n); }
                    chat(i) => { root.chat(i); }
                    pay(i) => { root.contact-pay(i); }
                    ask-remove(i) => { root.ask-remove(i); }
                    edit(i) => { root.contact-edit(i); }
                    apart(i) => { root.contact-apart(i); }
                    chat-send(t) => { root.chat-send(t); }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                preferred-width: 100px;
                min-width: 340px;
                spacing: 14px;
                LinkCard { vertical-stretch: 0; tor-tone: root.tor-tone; tx-tone: root.tx-tone; addr-tone: root.addr-tone; stages: root.sync-stages; rest: root.sync-rest; tor-on: root.tor-on; nostr-on: root.nostr-on; switch-tor(v) => { root.switch-tor(v); } switch-nostr(v) => { root.switch-nostr(v); } tor-line: root.tor-line; link-good: root.link-good; tx-line: root.tx-line; tx-good: root.tx-good; addr-line: root.addr-line; addr-good: root.addr-good; auto-receive: root.auto-receive; auto-on: root.auto-on; auto-known: root.auto-known; set-auto(v) => { root.set-auto(v); } bridges => { root.tor-options(); } }
                OpsCard { vertical-stretch: 1; ops: root.ops; all => { root.all-ops(); } show(i) => { root.op-show(i); } }
            }
          }
        }

        if root.narrow: Flickable {
            vertical-stretch: 1;
            // only up and down: a long line never makes the page wider than the screen
            content-width: self.width;
            content-height: column.preferred-height;
            column := VerticalLayout {
                width: parent.width;
                spacing: 10px;
                alignment: start;
                BalanceCard { balance: root.balance; balance-note: root.balance-note; incoming: root.incoming; verified: root.verified; verified-chip: root.verified-chip; verified-good: root.verified-good; narrow: true; open(n) => { root.open(n); } }
                if root.waiting.length > 0: WaitCard { waiting: root.waiting; note: root.wait-note; narrow: true; act(i, yes) => { root.act(i, yes); } }
                OpsCard { ops: root.ops; all => { root.all-ops(); } show(i) => { root.op-show(i); } }
                RequisitesCard { address-groups: root.address-groups; address-full: root.address-full; phrase: root.phrase; phrase-label: root.phrase-label; identity-made: root.identity-made; open(n) => { root.open(n); } make-identity => { root.make-identity(); } }
                ContactsCard { contacts: root.contacts; open(n) => { root.open(n); } chat(i) => { root.chat(i); } menu(i) => { root.contact-menu(i); } }
                LinkCard { tor-tone: root.tor-tone; tx-tone: root.tx-tone; addr-tone: root.addr-tone; stages: root.sync-stages; rest: root.sync-rest; tor-on: root.tor-on; nostr-on: root.nostr-on; switch-tor(v) => { root.switch-tor(v); } switch-nostr(v) => { root.switch-nostr(v); } tor-line: root.tor-line; link-good: root.link-good; tx-line: root.tx-line; tx-good: root.tx-good; addr-line: root.addr-line; addr-good: root.addr-good; auto-receive: root.auto-receive; auto-on: root.auto-on; auto-known: root.auto-known; set-auto(v) => { root.set-auto(v); } bridges => { root.tor-options(); } }
                ProblemsCard { problems: root.problems; more: root.problems-more; restart => { root.restart-wallet(); } }
                // a phone has no room for it in the top row
                Muted { text: "GrinSight " + root.app-version; font-size: 12px; horizontal-alignment: center; }
            }
        }
    }
}

export component App inherits Window {
    title: "GrinSight";
    icon: @image-url("../images/icon.png");
    preferred-width: 1280px;
    preferred-height: 960px;
    min-width: 900px;
    min-height: 640px;
    default-font-family: "Inter";
    background: Theme.bg;

    in-out property <int> page: 0;
    in property <string> version;
    in property <string> start-point;
    in property <string> own-nodes;
    in-out property <bool> options-open: true;
    in-out property <bool> testnet: false;
    in-out property <bool> direct-post: false;
    in property <bool> live: false;
    in property <bool> busy: false;
    in property <string> login-note;
    in-out property <string> login-error;
    in property <bool> has-profile: true;
    callback enter(string);
    callback go-create();
    callback go-restore();

    // creating and restoring
    in property <int> create-step: 0;
    in property <[string]> words;
    in property <[int]> ask;
    in-out property <string> flow-error;
    callback make(string, string);
    callback check(string, string, string);
    callback restore(string, string, string);
    callback back-to-login();

    // windows over the main screen: 1 send, 2 slatepack, 3 sign, 4 receive,
    // 5 incoming, 6 new contact, 10 an invoice to pay, 11 a payment from
    // before a restore
    in-out property <int> sheet: 0;
    in property <bool> sheet-busy: false;
    in-out property <string> sheet-error;
    in property <[string]> contact-names;
    in property <string> address-full;
    in property <string> out-title;
    in property <string> out-note;
    in property <string> out-text;
    in property <bool> out-wants-reply;
    in property <string> sign-amount;
    in property <string> sign-fee;
    in property <string> sign-total;
    in property <string> sign-who;
    in property <string> sign-who-note;
    in property <[string]> sign-who-groups;
    in property <bool> sign-can-cancel;
    in property <string> sign-tor-doubt;
    // O71: the wallet tries the built-in Tor bridges by itself
    in property <bool> sign-bridges-offered;
    in property <bool> sign-bridges-busy;
    in property <string> sign-bridges-note;
    callback sign-try-bridges();
    callback sign-stop-bridges();
    callback sign-direct();
    callback sign-tor-off();
    in property <string> in-amount;
    in property <string> in-from;
    in property <string> in-from-note;
    in property <[string]> in-from-groups;
    in property <string> inv-amount;
    in property <string> inv-fee;
    in property <string> inv-total;
    in property <string> inv-until;
    callback invoice-pay();
    in property <string> rel-note;
    callback release-payment();
    in property <string> wait-note;
    callback send-prepare(string, int, string);
    callback out-reply(string);
    callback sign();
    callback cancel-payment();
    callback receive-read(string);
    callback incoming-accept();
    callback incoming-decline();
    callback contact-add(string, string, string);
    // O64: asking for GRIN, and changing a contact
    callback invoice-make(string);
    callback contact-edit(int);
    in property <bool> contact-editing;
    // O65: the check code of the contact being changed, and the owner's mark
    in property <bool> contact-checked;
    in property <string> contact-code;
    callback contact-code-ask();
    callback contact-check(bool);
    in property <string> contact-edit-name;
    in property <string> contact-edit-address;
    callback sheet-closed(int);

    // the conversation (page 4), all payments (page 5), password and words (sheets 7, 8)
    in property <bool> identity-made;
    in property <bool> auto-on;
    in property <bool> auto-known;
    in property <string> chat-name;
    in property <string> chat-note;
    in property <[ChatLine]> chat-lines;
    in property <bool> chat-busy;
    in property <string> chat-error;
    in property <bool> chat-can-write: true;
    in property <[OpLine]> all-ops;
    // the wallet's outputs, the owner's marks and the choice for a payment (O51)
    in property <[OutLine]> outs;
    in property <string> picked-sum;
    in property <bool> picked-kept;
    in-out property <bool> spend-kept;
    callback out-keep(int, bool);
    in property <bool> gather;
    in property <string> collect-plan;
    in property <string> collect-done;
    in property <bool> collect-busy;
    callback set-gather(bool);
    callback collect-ask();
    callback collect-do();
    callback collect-cancel();
    callback out-pick(int);
    callback outs-unpick();
    // the history hidden in this window (O50)
    in property <int> ops-hidden;
    in property <[string]> op-contacts;
    callback hide-history();
    callback show-history();
    in-out property <string> security-note;
    in-out property <int> send-to: -1;
    callback op-show(int);
    callback open-chat(int);
    // O63: on a wide window a chosen contact's conversation stays on the main screen
    out property <bool> chat-inline: root.width >= 760px;
    callback contact-pay(int);
    callback contact-remove(int);
    callback contacts-remove-all();
    callback contacts-add-list(string, string);
    in property <string> contacts-note;
    // O70: a conversation in a window of its own (a computer only), and
    // why one did not open
    callback chat-apart(int);
    in property <string> apart-note;
    // for the sample screens: the conversation that is open on the main screen
    in property <int> chat-picked-at-start: -1;
    callback chat-send(string);
    callback chat-pay();
    callback chat-closed();
    // O75: the contact whose conversation is open (-1: none); the contact
    // whose deletion is asked; the contact whose actions a phone shows
    in property <int> chat-index: -1;
    in-out property <int> remove-asking: -1;
    in-out property <int> menu-for: -1;
    callback make-identity();
    callback set-auto(bool);
    callback change-password(string, string, string);
    callback show-words(string);
    callback delete-wallet(string, string, string);
    in property <string> files-path;
    in property <string> guard-path;
    in property <int> delete-place-a: 1;
    in property <int> delete-place-b: 2;
    callback words-closed();
    // O74: the 24 words as one line, for "Copy the words"; empty when they are not shown
    in property <string> words-line;
    // what was put on the clipboard, until the clipboard is emptied again
    property <string> words-clip;
    // O74: the words go to the clipboard; in a minute, or when the wallet
    // locks, the clipboard is emptied if it still holds them
    callback copy-words();
    copy-words => {
        if (root.words-line == "") { return; }
        words-out.text = root.words-line;
        words-out.select-all();
        words-out.copy();
        words-out.text = "";
        root.words-clip = root.words-line;
        words-timer.running = false;
        words-timer.running = true;
    }
    public function clear-copied-words() {
        if (root.words-clip != "") {
            words-probe.text = "";
            words-probe.paste();
            if (words-probe.text == root.words-clip) {
                words-blank.select-all();
                words-blank.copy();
                words-blank.clear-selection();
            }
            words-probe.text = "";
            root.words-clip = "";
        }
        words-timer.running = false;
    }
    in-out property <string> own-nodes-text;
    in-out property <string> own-point-text;
    callback direct-changed(bool);
    callback open-own();
    callback save-own(string, string);
    in property <string> tor-way;
    in-out property <int> tor-mode;
    in-out property <string> tor-own-text;
    in property <bool> tor-program;
    callback open-tor();
    callback save-tor(int, string);

    in property <string> wallet-name;
    in property <string> network;
    in property <string> balance;
    in property <string> balance-note;
    in property <string> incoming;
    in property <string> verified;
    in property <string> verified-chip: @tr("VERIFIED");
    in property <bool> verified-good: true;
    in property <[string]> address-groups;
    in property <string> phrase;
    in property <string> phrase-label: @tr("Phrase to find you in Nostr");
    in property <[Waiting]> waiting;
    in property <[Contact]> contacts;
    in property <[Op]> ops;
    in property <string> tor-line;
    in property <bool> link-good: true;
    in property <string> tx-line;
    in property <bool> tx-good: true;
    in property <string> addr-line;
    in property <bool> addr-good;
    in property <bool> out-can-tor;
    in property <bool> out-can-resend;
    in property <bool> out-can-direct;
    in property <string> out-resend-note;
    in property <bool> out-can-back;
    in property <bool> out-can-request;
    callback out-request();
    in property <string> out-back-plan;
    callback out-back-ask();
    callback out-back-do();
    callback out-back-cancel();
    callback out-resend(bool);
    callback out-tor-off();
    // confirmations after which an incoming payment is called received (K190)
    in property <int> confirmations: 10;
    callback set-confirmations(int);
    in property <bool> out-waiting;
    // the wallet has Tor for payments to an address
    in property <bool> tor-address;
    callback out-tor();
    in property <string> auto-receive;
    in property <string> app-version;
    in property <[SyncRow]> sync-rows;
    in property <[string]> sync-words;
    in property <int> tor-tone;
    in property <int> tx-tone;
    in property <int> addr-tone;
    in property <[SyncRow]> sync-stages;
    in property <[string]> sync-rest;
    in property <string> point-note;
    // O67: what a new point would give now, by how old the present one is
    in property <string> point-hint;
    in property <bool> point-good;
    in property <bool> point-busy;
    callback make-point();
    in property <bool> tor-on: true;
    in property <bool> nostr-on: true;
    callback switch-tor(bool);
    callback switch-nostr(bool);
    in property <[Problem]> problems;
    in property <string> problems-more;
    callback act(int, bool);
    callback leave();
    // O66: lock, start the wallet's processes anew, ask for the password again
    callback restart-wallet();

    // Android: keep clear of the status bar, the camera cut-out and the
    // gesture bar; on the desktop the insets are zero.
    Rectangle {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        // ends where the on-screen keyboard begins, when it is up
        height: (root.virtual-keyboard-size.height > 0 ? root.virtual-keyboard-position.y : root.height - root.safe-area-insets.bottom) - root.safe-area-insets.top;
        if root.page == 0: Login {
            version: root.version;
            start-point: root.start-point;
            own-nodes: root.own-nodes;
            options-open <=> root.options-open;
            testnet <=> root.testnet;
            direct-post <=> root.direct-post;
            tor-on: root.tor-on;
            nostr-on: root.nostr-on;
            switch-tor(v) => { root.switch-tor(v); }
            switch-nostr(v) => { root.switch-nostr(v); }
            live: root.live;
            has-profile: root.has-profile;
            busy: root.busy;
            note: root.login-note;
            error <=> root.login-error;
            enter(password) => { root.enter(password); }
            create => { root.go-create(); }
            restore => { root.go-restore(); }
            options => { root.open-own(); }
            tor-way: root.tor-way;
            tor-options => { root.open-tor(); }
            direct-changed(v) => { root.direct-changed(v); }
        }
        if root.page == 2: CreatePage {
            step: root.create-step;
            words: root.words;
            ask: root.ask;
            testnet: root.testnet;
            busy: root.busy;
            error <=> root.flow-error;
            make(a, b) => { root.make(a, b); }
            check(a, b, c) => { root.check(a, b, c); }
            back => { root.back-to-login(); }
        }
        if root.page == 3: RestorePage {
            testnet: root.testnet;
            busy: root.busy;
            error <=> root.flow-error;
            restore(w, a, b) => { root.restore(w, a, b); }
            back => { root.back-to-login(); }
        }
        if root.page == 1: Dashboard {
            wallet-name: root.wallet-name;
            address-full: root.address-full;
            app-version: root.app-version;
            sync-rows: root.sync-rows;
            sync-words: root.sync-words;
            sync-stages: root.sync-stages;
            tor-tone: root.tor-tone;
            tx-tone: root.tx-tone;
            addr-tone: root.addr-tone;
            sync-rest: root.sync-rest;
            problems: root.problems;
            problems-more: root.problems-more;
            network: root.network;
            balance: root.balance;
            balance-note: root.balance-note;
            incoming: root.incoming;
            verified: root.verified;
            verified-chip: root.verified-chip;
            verified-good: root.verified-good;
            address-groups: root.address-groups;
            phrase: root.phrase;
            phrase-label: root.phrase-label;
            waiting: root.waiting;
            wait-note: root.wait-note;
            contacts: root.contacts;
            ops: root.ops;
            tor-line: root.tor-line;
            tx-line: root.tx-line;
            tx-good: root.tx-good;
            addr-line: root.addr-line;
            addr-good: root.addr-good;
            link-good: root.link-good;
            auto-receive: root.auto-receive;
            leave => { root.leave(); }
            restart-wallet => { root.restart-wallet(); }
            act(i, yes) => { root.act(i, yes); }
            open(n) => { root.sheet-error = ""; root.security-note = ""; root.send-to = (n == 1 && root.tor-address && !Settings.by-hand) ? -2 : -1; root.sheet = n; }
            identity-made: root.identity-made;
            auto-on: root.auto-on; auto-known: root.auto-known;
            chat(i) => { root.open-chat(i); }
            chat-name: root.chat-name;
            chat-note: root.chat-note;
            chat-lines: root.chat-lines;
            chat-busy: root.chat-busy;
            chat-error: root.chat-error;
            chat-can-write: root.chat-can-write;
            picked-at-start: root.chat-index >= 0 ? root.chat-index : root.chat-picked-at-start;
            chat-send(t) => { root.chat-send(t); }
            contact-pay(i) => { root.contact-pay(i); }
            contact-remove(i) => { root.contact-remove(i); }
            ask-remove(i) => { root.remove-asking = i; }
            contact-menu(i) => { root.menu-for = i; }
            contact-edit(i) => { root.contact-edit(i); }
            contact-apart(i) => {
                if (Device.phone) {
                    root.open-chat(i);
                    root.page = 4;
                } else {
                    root.chat-apart(i);
                }
            }
            apart-note: root.apart-note;
            make-identity => { root.make-identity(); }
            set-auto(v) => { root.set-auto(v); }
            op-show(i) => { root.op-show(i); }
            tor-on: root.tor-on;
            nostr-on: root.nostr-on;
            switch-tor(v) => { root.switch-tor(v); }
            switch-nostr(v) => { root.switch-nostr(v); }
            tor-options => { root.open-tor(); }
            all-ops => { root.page = 5; }
        }
        if root.page == 4: ChatPage {
            name: root.chat-name;
            note: root.chat-note;
            lines: root.chat-lines;
            busy: root.chat-busy;
            error: root.chat-error;
            can-write: root.chat-can-write;
            back => { root.chat-closed(); root.page = 1; }
            send(t) => { root.chat-send(t); }
            pay => { root.chat-pay(); }
            ask => { root.sheet-error = ""; root.sheet = 4; }
            edit => { root.contact-edit(root.chat-index); }
            remove => { root.remove-asking = root.chat-index; }
            checked: root.chat-index >= 0 && root.chat-index < root.contacts.length && root.contacts[root.chat-index].checked;
        }
        if root.page == 5: OpsPage {
            ops: root.all-ops;
            hidden-count: root.ops-hidden;
            contacts: root.op-contacts;
            hide => { root.hide-history(); }
            unhide => { root.show-history(); }
            confirmations: root.confirmations;
            set-confirmations(n) => { root.set-confirmations(n); }
            back => { root.page = 1; }
            show(i) => { root.op-show(i); }
        }
        if (root.page == 1 || root.page == 4) && root.sheet == 1: SendSheet {
            contacts: root.contact-names;
            by-hand: Settings.by-hand;
            to <=> root.send-to;
            tor-address: root.tor-address;
            spendable: root.balance;
            busy: root.sheet-busy;
            error: root.sheet-error;
            close => { root.sheet-closed(root.sheet); root.sheet = 0; }
            prepare(a, to, addr) => { root.send-prepare(a, to, addr); }
            outs: root.outs;
            picked-sum: root.picked-sum;
            picked-kept: root.picked-kept;
            spend-kept <=> root.spend-kept;
            pick(i) => { root.out-pick(i); }
            unpick => { root.outs-unpick(); }
        }
        if root.page == 1 && root.sheet == 14: ContactsSheet {
            contacts: root.contacts;
            note: root.contacts-note;
            busy: root.sheet-busy;
            error: root.sheet-error;
            close => { root.sheet-closed(root.sheet); root.sheet = 0; }
            remove(i) => { root.contact-remove(i); }
            remove-all => { root.contacts-remove-all(); }
            add-list(keys, addresses) => { root.contacts-add-list(keys, addresses); }
        }
        if (root.page == 1 || root.page == 4) && root.sheet == 13: OutputsSheet {
            outs: root.outs;
            error: root.sheet-error;
            close => { root.sheet-closed(root.sheet); root.sheet = 0; }
            keep(i, on) => { root.out-keep(i, on); }
            gather: root.gather;
            plan: root.collect-plan;
            done: root.collect-done;
            busy: root.collect-busy;
            set-gather(on) => { root.set-gather(on); }
            collect-ask => { root.collect-ask(); }
            collect-do => { root.collect-do(); }
            collect-cancel => { root.collect-cancel(); }
        }
        if (root.page == 1 || root.page == 4) && root.sheet == 2: SlateSheet {
            title: root.out-title;
            note: root.out-note;
            out: root.out-text;
            wants-reply: root.out-wants-reply;
            can-tor: root.out-can-tor;
            can-resend: root.out-can-resend;
            can-direct: root.out-can-direct;
            resend-note: root.out-resend-note;
            can-back: root.out-can-back;
            can-request: root.out-can-request;
            request => { root.out-request(); }
            back-plan: root.out-back-plan;
            back-ask => { root.out-back-ask(); }
            back-do => { root.out-back-do(); }
            back-cancel => { root.out-back-cancel(); }
            resend(d) => { root.out-resend(d); }
            tor-off => { root.out-tor-off(); }
            waiting: root.out-waiting;
            tor => { root.out-tor(); }
            busy: root.sheet-busy;
            error: root.sheet-error;
            card-width: 640px;
            close => { root.sheet-closed(root.sheet); root.sheet = 0; }
            reply(t) => { root.out-reply(t); }
        }
        if root.page == 1 && root.sheet == 3: SignSheet {
            amount: root.sign-amount;
            fee: root.sign-fee;
            total: root.sign-total;
            who: root.sign-who;
            who-note: root.sign-who-note;
            who-groups: root.sign-who-groups;
            can-cancel: root.sign-can-cancel;
            tor-doubt: root.sign-tor-doubt;
            bridges-offered: root.sign-bridges-offered;
            bridges-busy: root.sign-bridges-busy;
            bridges-note: root.sign-bridges-note;
            try-bridges => { root.sign-try-bridges(); }
            stop-bridges => { root.sign-stop-bridges(); }
            sign-direct => { root.sign-direct(); }
            tor-off => { root.sign-tor-off(); }
            busy: root.sheet-busy;
            error: root.sheet-error;
            close => { root.sheet-closed(root.sheet); root.sheet = 0; }
            sign => { root.sign(); }
            cancel-payment => { root.cancel-payment(); }
        }
        if root.page == 1 && root.sheet == 4: ReceiveSheet {
            groups: root.address-groups;
            full: root.address-full;
            busy: root.sheet-busy;
            error: root.sheet-error;
            card-width: 640px;
            close => { root.sheet-closed(root.sheet); root.sheet = 0; }
            read(t) => { root.receive-read(t); }
            invoice(a) => { root.invoice-make(a); }
        }
        if root.page == 1 && root.sheet == 5: IncomingSheet {
            amount: root.in-amount;
            from: root.in-from;
            from-note: root.in-from-note;
            from-groups: root.in-from-groups;
            busy: root.sheet-busy;
            error: root.sheet-error;
            close => { root.sheet-closed(root.sheet); root.sheet = 0; }
            accept => { root.incoming-accept(); }
            decline => { root.incoming-decline(); }
        }
        if root.page == 1 && root.sheet == 10: InvoiceSheet {
            amount: root.inv-amount;
            fee: root.inv-fee;
            total: root.inv-total;
            until: root.inv-until;
            busy: root.sheet-busy;
            error: root.sheet-error;
            close => { root.sheet-closed(root.sheet); root.sheet = 0; }
            pay => { root.invoice-pay(); }
        }
        if root.page == 1 && root.sheet == 11: ReleaseSheet {
            note: root.rel-note;
            busy: root.sheet-busy;
            error: root.sheet-error;
            close => { root.sheet-closed(root.sheet); root.sheet = 0; }
            release => { root.release-payment(); }
        }
        if (root.page == 1 || root.page == 4) && root.sheet == 7: SecuritySheet {
            busy: root.sheet-busy;
            error: root.sheet-error;
            done-note: root.security-note;
            close => { root.sheet-closed(root.sheet); root.sheet = 0; }
            change(a, b, c) => { root.change-password(a, b, c); }
            words(p) => { root.show-words(p); }
            place-a: root.delete-place-a;
            place-b: root.delete-place-b;
            delete(p, a, b) => { root.delete-wallet(p, a, b); }
            files-path: root.files-path;
            guard-path: root.guard-path;
        }
        if root.page == 1 && root.sheet == 8: WordsSheet {
            words: root.words;
            line: root.words-line;
            card-width: 720px;
            copy-words => { root.copy-words(); }
            close => { root.words-closed(); root.sheet = 0; }
        }
        if (root.page == 1 || root.page == 4 || root.page == 5) && root.sheet == 15: SyncSheet {
            rows: root.sync-rows;
            words: root.sync-words;
            point-note: root.point-note;
            point-hint: root.point-hint;
            point-good: root.point-good;
            point-busy: root.point-busy;
            make-point => { root.make-point(); }
            close => { root.sheet = 0; }
        }
        if (root.page == 1 || root.page == 4 || root.page == 5) && root.sheet == 16: SettingsSheet {
            open(n) => { root.sheet-error = ""; root.security-note = ""; root.sheet = n; }
            bridges => { root.open-tor(); }
            close => { root.sheet = 0; }
        }
        if root.page == 0 && root.sheet == 9: OwnSheet {
            nodes <=> root.own-nodes-text;
            point <=> root.own-point-text;
            error: root.sheet-error;
            done-note: root.security-note;
            card-width: 640px;
            close => { root.sheet = 0; }
            save(n, p) => { root.save-own(n, p); }
        }
        if (root.page == 0 || root.page == 1) && root.sheet == 12: TorSheet {
            mode <=> root.tor-mode;
            own <=> root.tor-own-text;
            has-program: root.tor-program;
            error: root.sheet-error;
            done-note: root.security-note;
            card-width: 640px;
            close => { root.sheet = 0; }
            save(m, o) => { root.save-tor(m, o); }
        }
        if root.page == 1 && root.sheet == 6: ContactSheet {
            busy: root.sheet-busy;
            error: root.sheet-error;
            editing: root.contact-editing;
            checked: root.contact-checked;
            code: root.contact-code;
            show-code => { root.contact-code-ask(); }
            check(on) => { root.contact-check(on); }
            start-name: root.contact-edit-name;
            start-address: root.contact-edit-address;
            close => { root.sheet-closed(root.sheet); root.sheet = 0; }
            add(n, k, a) => { root.contact-add(n, k, a); }
        }
        // O73: what a "?" says, over everything, at the size of ordinary text
        // O75: a phone's actions on one contact, from the bottom of the screen
        if root.menu-for >= 0 && root.menu-for < root.contacts.length: Rectangle {
            background: #000000a0;
            TouchArea { clicked => { root.menu-for = -1; } }
            Rectangle {
                x: 0px;
                y: parent.height - self.height;
                width: parent.width;
                height: sheet-items.preferred-height;
                background: Theme.card;
                border-top-left-radius: 20px;
                border-top-right-radius: 20px;
                TouchArea { }
                sheet-items := VerticalLayout {
                    padding: 14px;
                    padding-bottom: 26px;
                    spacing: 2px;
                    Text { text: root.contacts[root.menu-for].name; color: Theme.text; font-size: 16px; font-weight: 700; overflow: elide; }
                    Rectangle { height: 8px; }
                    MenuItem { sign: Icons.send; text: @tr("Send GRIN to the contact"); clicked => { root.contact-pay(root.menu-for); root.menu-for = -1; } }
                    MenuItem { sign: Icons.edit; text: @tr("Change the contact's details"); clicked => { root.contact-edit(root.menu-for); root.menu-for = -1; } }
                    MenuItem { sign: Icons.trash; text: @tr("Delete the contact…"); danger: true; clicked => { root.remove-asking = root.menu-for; root.menu-for = -1; } }
                    Rectangle { height: 8px; }
                    Btn { text: @tr("Cancel"); min-height: 46px; clicked => { root.menu-for = -1; } }
                }
            }
        }
        // O75: deleting a contact is asked in a window of its own
        if root.remove-asking >= 0 && root.remove-asking < root.contacts.length: Rectangle {
            background: #000000b0;
            TouchArea { clicked => { root.remove-asking = -1; } }
            Card {
                width: min(460px, root.width - 32px);
                height: remove-words.preferred-height;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                TouchArea { }
                remove-words := VerticalLayout {
                    padding: 24px;
                    spacing: 14px;
                    Text { text: @tr("Delete the contact “{}”?", root.contacts[root.remove-asking].name); color: Theme.text; font-size: 18px; font-weight: 700; wrap: word-wrap; }
                    Text { text: @tr("The conversation with them is deleted too. Payments stay in the list of payments."); color: Theme.text; font-size: 15px; wrap: word-wrap; }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Btn { text: @tr("Cancel"); min-height: 42px; clicked => { root.remove-asking = -1; } }
                        Btn {
                            text: @tr("Delete");
                            primary: true;
                            min-height: 42px;
                            clicked => {
                                if (root.remove-asking == root.chat-index && root.page == 4) {
                                    root.chat-closed();
                                    root.page = 1;
                                }
                                root.contact-remove(root.remove-asking);
                                root.remove-asking = -1;
                            }
                        }
                    }
                }
            }
        }
        if Help.open: Rectangle {
            background: #000000b0;
            TouchArea { clicked => { Help.open = false; } }
            help-card := Card {
                width: min(560px, root.width - 32px);
                height: min(help-words.preferred-height, root.height - 32px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                TouchArea { }
                Flickable {
                    content-height: help-words.preferred-height;
                    help-words := VerticalLayout {
                        width: parent.width;
                        padding: 26px;
                        spacing: 16px;
                        Text { text: Help.title; color: Theme.text; font-size: 19px; font-weight: 700; wrap: word-wrap; }
                        Text { text: Help.text; color: Theme.text; font-size: 15px; wrap: word-wrap; }
                        HorizontalLayout {
                            alignment: end;
                            Btn { text: @tr("Got it"); primary: true; min-height: 42px; clicked => { Help.open = false; } }
                        }
                    }
                }
            }
        }
    }
    // O74: the clipboard, through fields nobody sees
    words-out := TextInput { width: 0px; height: 0px; visible: false; }
    words-probe := TextInput { width: 0px; height: 0px; visible: false; }
    words-blank := TextInput { text: " "; read-only: true; width: 0px; height: 0px; visible: false; }
    words-timer := Timer { interval: 60s; running: false; triggered => { root.clear-copied-words(); } }
}
