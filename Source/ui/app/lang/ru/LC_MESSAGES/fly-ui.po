msgstr "Выкл"

msgid "Preparing…"
msgstr "Готовлю…"

msgid "Done"
msgstr "Готово"

msgid "Next"
msgstr "Дальше"

msgid "For a new wallet. Testnet — for trying without real money"
msgstr "Для нового кошелька. Testnet — для проб без настоящих денег"

msgid "Add a contact"
msgstr "Добавить контакт"

msgid "Payment delivery"
msgstr "Доставка платежей"

msgid "Available "
msgstr "Доступно "

