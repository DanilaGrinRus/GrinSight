msgid "Change the password, see the 24 words again, delete the wallet from this computer"
msgstr "암호를 변경하고, 24 단어를 다시 보고, 이 컴퓨터에서 지갑을 삭제하십시오."

msgid "Check"
msgstr "확인"

msgid "Check all headers from genesis and build your own checkpoint. On Mainnet the first pass can download about 1.7 GB and take tens of minutes. It locks the wallet; unlock it to begin. Progress is in Details."
msgstr "genesis에서 모든 헤더를 확인하고 자신만의 체크포인트를 만들어보세요. On Mainnet 첫 번째 패스는 약 다운로드 할 수 있습니다 1.7 GB 및 분 수십 걸립니다. 그것은 지갑을 잠그고; 시작하기 위해 잠금을 해제. 진행 상태는 세부 사항입니다."

#. runtime
msgid "Check the address with the recipient another way."
msgstr "다른 방법으로 수신자와 주소를 확인하십시오."

#. runtime
msgid "Check the address with the sender some other way."
msgstr "다른 방법으로 발신자와 주소를 확인하십시오."

#. runtime
msgid "Check the operation before paying again. A signature may already exist."
msgstr "다시 결제하기 전에 거래를 확인하세요. 이미 서명되었을 수 있습니다."

#. runtime
msgid "Check this invoice. Its signing result is unknown."
msgstr "이 청구서를 확인해 보세요 서명 결과는 알 수 없습니다"

msgid "Check this network’s headers from its first block? A first Mainnet check can download about 1.7 GB. The wallet will lock. Unlock it to start or resume the check."
msgstr "이 네트워크의 첫 블록부터 헤더를 검증할까요? Mainnet의 첫 검증에는 약 1.7 GB를 다운로드할 수 있습니다. 지갑이 잠깁니다. 검증을 시작하거나 재개하려면 잠금을 해제하세요."

#. runtime
msgid "Check this payment. Signing may have completed."
msgstr "이 결제를 확인하세요 서명이 완료되었을 수 있습니다."

msgid "Checking…"
msgstr "검증 중…"

#. runtime
msgid "Checkpoint for block {} saved."
msgstr "블록 {}의 체크포인트가 저장되었습니다."

#. runtime
msgid "Checkpoint saved at block {}. GSHP1 samples verified: {}. Unlock to continue."
msgstr "체크포인트가 블록 {}에 저장되었습니다 GSHP1 샘플 확인: {} 계속하려면 잠금을 해제하세요"

msgid "Choose a .gshp file from another wallet, or checkpoint.json with history.proof in the same folder. GSHP1 is checked locally. The next sync downloads blocks after the point. Import locks the wallet and ends unfinished signing sessions."
msgstr "를 선택합니다.gshp 다른 지갑에서 파일, 또는 checkpoint.json 함께 history.proof 같은 폴더에 있습니다. GSHP1 다음 동기화는 포인트 이후의 블록을 다운로드합니다. 가져오기는 지갑을 잠그고 완료되지 않은 서명 세션을 종료합니다."

msgid "Choose a contact"
msgstr "연락처 선택"

msgid "Choose a contact on the left to see the conversation."
msgstr "대화를 보려면 왼쪽에 있는 연락처를 선택하십시오."

msgid "Choose a contact on the right to see the conversation."
msgstr "대화를 보려면 오른쪽에 있는 연락처를 선택합니다."

msgid "Choose a password"
msgstr "비밀번호 선택"

msgid "Choose checkpoint file…"
msgstr "체크포인트 파일 선택..."

msgid "Choose the outputs to pay with"
msgstr "지불할 출력을 선택하세요"

